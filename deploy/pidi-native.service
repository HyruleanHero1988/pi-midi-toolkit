[Unit]
Description=PiDI native jambox kiosk (SDL/KMSDRM)
# After jambox only — jambox must not After=multi-user (ordering cycle drops us).
After=jambox-engine.service sound.target
Wants=jambox-engine.service

[Service]
Type=simple
User=pi
Group=pi
SupplementaryGroups=audio video render input
WorkingDirectory=/home/pi/pi-midi-toolkit
ExecStart=/home/pi/pi-midi-toolkit/bin/pidi-native \
  --control /tmp/jambox.sock \
  --display sdl \
  --touch auto
Restart=on-failure
RestartSec=2
Environment=RUST_LOG=info
Environment=SDL_VIDEODRIVER=kmsdrm
Environment=SDL_AUDIODRIVER=dummy
# User library (songs/pads/settings/presets/user waves/Wi-Fi) — never under the git tree.
Environment=PIDI_DATA_ROOT=%h/.local/share/pidi
Environment=PIDI_REPO_ROOT=/home/pi/pi-midi-toolkit
Environment=JAMBOX_USER_WAVETABLES=%h/.local/share/pidi/user-wavetables

[Install]
WantedBy=multi-user.target
