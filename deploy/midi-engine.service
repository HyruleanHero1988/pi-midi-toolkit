[Unit]
Description=pi-midi-toolkit MIDI engine
After=sound.target multi-user.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/pi-midi-toolkit
ExecStart=/home/pi/pi-midi-toolkit/bin/midi-engine run --preset /home/pi/pi-midi-toolkit/presets/active.json --watch --rt
Restart=on-failure
RestartSec=2
# Soft realtime when the kernel allows it (see deploy/setup-pi.sh limits.d).
LimitRTPRIO=95
LimitMEMLOCK=infinity
# Keep USB MIDI devices available after suspend/resume glitches.
Environment=RUST_LOG=info

[Install]
WantedBy=multi-user.target
