[Unit]
Description=pi-midi-toolkit jambox audio + sequencer engine (native kiosk)
# Do not After=multi-user.target — that cycles with WantedBy=multi-user and
# causes systemd to drop dependent units (e.g. pidi-native) from the boot job.
After=sound.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/pi-midi-toolkit
# The kiosk UI connects to the control socket; it never renders audio itself.
ExecStart=/home/pi/pi-midi-toolkit/bin/jambox-engine run \
  --midi-in MPK \
  --output headphone \
  --control /tmp/jambox.sock \
  --waves /home/pi/pi-midi-toolkit/apps/pidi/wavetables \
  --user-waves /home/pi/pi-midi-toolkit/apps/pidi/user-wavetables \
  --buffer-frames 0 \
  --rt
Restart=on-failure
RestartSec=2
# Soft realtime when the kernel allows it (see deploy/setup-pi.sh limits.d).
LimitRTPRIO=95
LimitMEMLOCK=infinity
Environment=RUST_LOG=info

[Install]
WantedBy=multi-user.target
