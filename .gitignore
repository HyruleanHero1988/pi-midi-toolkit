# Rust
/target/
**/*.rs.bk
# Keep Cargo.lock for reproducible app builds
# Cargo.lock

# IDE / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Local presets / takes (keep shipped examples)
/presets/*.json
!/presets/example.json
!/presets/mpk-mini-ch3.json
/takes/

# Appliance user data (native kiosk also honors PIDI_DATA_ROOT)
/songs/
/phrases/
/settings.json
/user-presets/
/user-wavetables/
crates/pidi-native/phrases/

# Deploy scratch. Committed Pi engines live in dist/armv7/ (see deploy/build-pi-bins.sh).
/dist/*
!/dist/armv7/
!/dist/armv7/**
.cargo/config.toml

# Python / PiDI kiosk
apps/pidi/.venv/
apps/pidi/.pi-credentials
apps/pidi/.update-credentials
apps/pidi/.wifi-credentials
apps/pidi/settings.json
apps/pidi/version.json
apps/pidi/user-presets/
apps/pidi/user-wavetables/
# User song library (any .mid you drop here — not committed; demo-songs/ ships in repo)
apps/pidi/songs/
apps/pidi/phrases/
apps/pidi/archive/debug/
apps/pidi/_pi-user-backup/
apps/pidi/_icon_build/
__pycache__/
*.pyc

